# ─── Server ────────────────────────────────────────────────────────────────────
# Port the Node.js server listens on.
PORT=9090

# Directory where foundry.db (SQLite) is stored.
# In Docker/Coolify this maps to the persistent volume mounted at /data.
DATA_DIR=./data

# Password protection for the whole app (login page shown before anything else).
# Defaults to "admin" when unset. Set to "off" to disable auth entirely.
# In Coolify, set this as an environment variable in the service config.
APP_PASSWORD=admin

# ─── AI / Pipeline (all optional — configure in-app Settings UI instead) ──────
# You do NOT need to set any AI keys here.
# All model configuration (host, API key, model id) is done inside the app
# via the Settings page and stored in your browser only — never on the server.
